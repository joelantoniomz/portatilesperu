# ==============================================================================
# PORTÁTILES PERÚ - VARIABLES DE ENTORNO DE EJEMPLO
# Copiar este archivo a .env y configurar los valores específicos del entorno.
# NUNCA subir claves privadas ni secretos reales al repositorio.
# ==============================================================================

APP_NAME="Portátiles Perú"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Lima
APP_URL=http://portatiles-peru.test
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

# Configuración de Logs
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de Datos (MySQL / MariaDB en Laragon)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portatiles_peru
DB_USERNAME=root
DB_PASSWORD=

# Drivers de Sesión, Caché y Colas
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
CACHE_PREFIX=

QUEUE_CONNECTION=database

# Almacenamiento de Archivos (Imágenes, Catálogos PDF, Exportaciones)
FILESYSTEM_DISK=public

# Correo Electrónico (Mailpit integrado en Laragon)
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="info@portatilesperu.com"
MAIL_FROM_NAME="${APP_NAME}"

# Configuración Comercial y WhatsApp (Modo Enlace y Modo Cloud API)
STORE_CURRENCY=PEN
STORE_DEFAULT_PHONE="51900000000"
STORE_DEFAULT_MESSAGE="¡Hola! Deseo información y confirmar disponibilidad para la solicitud referencia: {reference}"

# WhatsApp Business Cloud API (Opcional - Requerido únicamente para bandeja integrada)
WHATSAPP_CLOUD_API_ENABLED=false
WHATSAPP_CLOUD_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# No habilitar la API hasta completar la verificación de Meta y las pruebas reales autorizadas.

# Configuración de Copias de Seguridad (Spatie Backup / Comando de Sistema)
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=

# OpenWA - Conexión con WhatsApp REST API y Webhooks
OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=default
OPENWA_WEBHOOK_SECRET=
OPENWA_TIMEOUT=15

# Google Gemini AI (Autocompletado de productos, clasificación y fichas técnicas)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

